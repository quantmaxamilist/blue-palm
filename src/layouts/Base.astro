---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, brand, contact, google, social, properties, home, tracking } from '../data/site';

interface Props { title: string; desc: string; path?: string; image?: string; schema?: object[]; crumbs?: { name: string; path: string }[]; noindex?: boolean; band?: boolean; heroDark?: boolean }
const { title, desc, path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', image = '/og.jpg', schema = [], crumbs = [], noindex = false, band = true, heroDark = true } = Astro.props;
const canonical = SITE + (path === '/' ? '/' : path);

const org = {
  '@context': 'https://schema.org',
  '@type': ['LodgingBusiness', 'LocalBusiness'],
  '@id': SITE + '/#business',
  name: 'Blue Palm Corporate Housing',
  alternateName: ['Blue Palm', 'Blue Palm Apartments', 'Blue Palm Property'],
  legalName: brand.legal,
  url: SITE + '/',
  logo: SITE + '/img/brand/blue-palm-logo.png',
  image: SITE + '/og.jpg',
  description: home.desc,
  email: contact.email,
  ...(contact.phone ? { telephone: contact.phone } : {}),
  address: { '@type': 'PostalAddress', streetAddress: 'Schooner Wharf', addressLocality: 'Cardiff', postalCode: 'CF10 4EY', addressRegion: 'Wales', addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: google.geo.lat, longitude: google.geo.lng },
  hasMap: google.url,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: google.rating, reviewCount: google.count, bestRating: 5 },
  review: google.reviews.map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.name }, reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 }, reviewBody: r.text, publisher: { '@type': 'Organization', name: 'Google' } })),
  areaServed: [{ '@type': 'City', name: 'Cardiff' }, { '@type': 'Place', name: 'Pontcanna' }, { '@type': 'Place', name: 'Cardiff Bay' }, { '@type': 'AdministrativeArea', name: 'South Wales' }],
  foundingDate: String(brand.since),
  vatID: 'GB351209527',
  identifier: { '@type': 'PropertyValue', propertyID: 'Companies House', value: '11749269' },
  knowsAbout: ['Corporate housing', 'Serviced apartments', 'Corporate accommodation', 'Contractor accommodation', 'Relocation housing', 'Film and TV production accommodation', 'Guaranteed rent', 'Serviced accommodation management'],
  makesOffer: properties.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Accommodation', name: p.name, url: `${SITE}/${p.slug}` } })),
  sameAs: [social.facebook, social.linkedin, google.url],
};
const site = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE + '/#website', url: SITE + '/', name: 'Blue Palm Corporate Housing Cardiff', publisher: { '@id': SITE + '/#business' }, inLanguage: 'en-GB' };
const bc = crumbs.length ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE + (c.path === '/' ? '/' : c.path) })) }] : [];
const ld = [org, site, ...bc, ...schema];
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <script is:inline define:vars={{ gtm: tracking.gtm }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#213d99" />
  <meta name="geo.region" content="GB-CRF" />
  <meta name="geo.placename" content="Cardiff" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Blue Palm Corporate Housing Cardiff" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={SITE + image} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />
  <script is:inline>document.documentElement.classList.add('js');if(matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('reduced');</script>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${tracking.gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#main">Skip to content</a>
  <Header heroDark={heroDark} />
  <main id="main"><slot /></main>
  <Footer band={band} />
  <script>
    import { initMotion } from '../scripts/motion';
    initMotion();
  </script>
</body>
</html>
