---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Clients from '../components/Clients.astro';
import Pic from '../components/Pic.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Faq from '../components/Faq.astro';
import { home, properties, landlords, SITE } from '../data/site';
const feat = home.featured.map((f) => ({ ...f, p: properties.find((p) => p.slug === f.slug)! }));
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: home.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title={home.title} desc={home.desc} path="/" schema={[faqLd]}>
  <HomeHero />
  <Clients />

  <section class="sec white props" aria-labelledby="pr-h">
    <div class="wrap">
      <div class="pr-head">
        <div><p class="kicker" data-reveal>The portfolio</p><h2 id="pr-h" data-reveal=".05">Homes, not hotel rooms.</h2></div>
        <a class="link" href="/properties" data-reveal>View Portfolio →</a>
      </div>
      {feat.map((f, i) => (
        <article class:list={['spread', { rev: i % 2 === 1 }]}>
          <a class="ph sp-img" href={`/${f.slug}`} data-reveal tabindex="-1" aria-hidden="true"><Pic k={f.p.imgs[0]} alt="" sizes="(max-width: 880px) 100vw, 60vw" /></a>
          <div class="sp-copy" data-reveal=".08">
            <span class="num mono">0{i + 1} / 0{feat.length}</span>
            <h3><a href={`/${f.slug}`}>{f.name}</a></h3>
            <p class="spec mono">{f.spec}</p>
            <p>{f.d}</p>
            <div class="sp-cta"><a class="btn" href={`/${f.slug}`}>View apartment <span class="arr">→</span></a><a class="link" href={`/contact?package=${f.slug}`}>Request corporate rates</a></div>
          </div>
        </article>
      ))}
      <div class="more" data-reveal><a class="btn ghost" href="/properties">See all {properties.length} apartments <span class="arr">→</span></a></div>
    </div>
  </section>

  <section class="sec living" aria-labelledby="liv-h">
    <div class="wrap liv">
      <div class="liv-copy">
        <p class="kicker" data-reveal>Pontcanna, Cardiff</p>
        <h2 id="liv-h" data-reveal=".05">{home.designedH}</h2>
        <p data-reveal=".1">{home.designed}</p>
        <p class="statement" data-reveal=".12">{home.ideal}</p>
        <a class="btn" href="/contact" data-reveal=".15">Book your stay <span class="arr">→</span></a>
      </div>
      <div class="liv-pics">
        <div class="ph a" data-reveal><Pic k="misc-7" alt="Victorian terraced street in Pontcanna, Cardiff" sizes="(max-width: 880px) 70vw, 30vw" w={800} /></div>
        <div class="ph b" data-reveal=".08"><Pic k="hamilton-top-floor-1" alt="Living room with yellow sofa in a Blue Palm apartment on Hamilton Street" sizes="(max-width: 880px) 80vw, 34vw" /></div>
        <div class="ph c" data-reveal=".14"><Pic k="wyndham-crescent-10" alt="Styled sideboard in a Blue Palm Wyndham Crescent apartment" sizes="(max-width: 880px) 50vw, 20vw" w={800} /></div>
      </div>
    </div>
  </section>

  <section class="sec dark why" aria-labelledby="why-h">
    <div class="wrap">
      <p class="kicker" data-reveal>For companies</p>
      <h2 id="why-h" class="sr">{home.whyH}</h2>
      <p class="big statement" data-reveal=".05"><span class="q">{home.whyH}</span> {home.why}</p>
      <div class="steps">
        <h3 class="mono st-h" data-reveal>{home.stepsH}</h3>
        <ol>
          {home.steps.map((s, i) => (
            <li data-reveal={String(i * 0.08)}>
              <span class="n">{i + 1}</span>
              <h4>{s.t}</h4>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
        <a class="btn white" href="/contact" data-reveal>Book Today <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec quotes" aria-labelledby="q-h">
    <div class="wrap">
      <p class="kicker" data-reveal>{home.saying}</p>
      <h2 id="q-h" data-reveal=".05">From the people who stayed.</h2>
      <div class="q-grid">
        {home.testimonials.map((t, i) => (
          <figure class:list={['qt', { big: i === 0 }]} data-reveal={String((i % 2) * 0.08)}>
            <blockquote>“{t.q}”</blockquote>
            <figcaption><strong>{t.n}</strong><span class="mono">{t.c}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec blue ll" aria-labelledby="ll-h">
    <div class="wrap split">
      <div>
        <p class="kicker light" data-reveal>For landlords</p>
        <h2 id="ll-h" data-reveal=".05">{landlords.kicker}</h2>
        <p class="lede" data-reveal=".1">{landlords.sub}</p>
        <div class="ll-cta" data-reveal=".15">
          <a class="btn white" href="/agents-landlords#open-calculator">Compare your rental profits <span class="arr">→</span></a>
          <a class="btn ghost" href="/management">Serviced accommodation management</a>
        </div>
      </div>
      <ul class="ll-stats">
        {landlords.stats.map((s, i) => <li data-reveal={String(i * 0.06)}><strong>{s.n}</strong><span>{s.d}</span></li>)}
      </ul>
    </div>
  </section>

  <GoogleReviews />
  <Faq items={home.faq} tone="light-faq" />
</Base>

<style>
  .liv { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(36px, 6vw, 100px); align-items: center; }
  .liv-copy > p:not(.statement):not(.kicker) { color: var(--muted); }
  .liv-copy .statement { color: var(--blue); margin: 26px 0 30px; }
  .liv-pics { position: relative; aspect-ratio: 1 / 1.05; }
  .liv-pics .ph { position: absolute; box-shadow: 0 40px 70px -40px rgba(10,20,48,.45); }
  .liv-pics .a { left: 0; top: 4%; width: 46%; aspect-ratio: 3/4; border-radius: 999px 999px var(--r) var(--r); }
  .liv-pics .b { right: 0; top: 18%; width: 62%; aspect-ratio: 4/5; }
  .liv-pics .c { left: 14%; bottom: 0; width: 38%; aspect-ratio: 1; border-radius: 50%; border: 6px solid var(--paper); }
  .pr-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }
  .pr-head h2 { margin: 0; }
  .spread { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding-block: clamp(28px, 4vw, 52px); border-top: 1px solid var(--line); }
  .spread.rev { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
  .spread.rev .sp-img { order: 2; }
  .sp-img { aspect-ratio: 3 / 2; display: block; }
  .sp-img :global(img) { transition: transform 1.2s var(--ease); }
  .sp-img:hover :global(img) { transform: scale(1.04); }
  .num { font-size: .74rem; color: var(--muted); letter-spacing: .1em; }
  .sp-copy h3 { margin: 14px 0 8px; font-size: var(--fs-display-3); }
  .sp-copy h3 a { text-decoration: none; }
  .spec { color: var(--blue); font-size: .8rem; margin-bottom: 14px; }
  .sp-copy p:not(.spec) { color: var(--muted); }
  .sp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 22px; }
  .more { display: flex; justify-content: center; margin-top: 30px; }
  .why .big { font-size: var(--fs-statement); line-height: 1.38; color: #eef1fb; max-width: 44ch; }
  .why .big .q { color: #93a6ef; }
  .steps { margin-top: clamp(56px, 8vw, 110px); }
  .st-h { font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; color: #93a6ef; font-weight: 500; }
  .steps ol { list-style: none; padding: 0; margin: 26px 0 40px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .steps li { border-top: 1px solid var(--line-d); padding-top: 26px; }
  .n { display: block; font: 760 var(--fs-display-1)/0.9 var(--f-display); color: transparent; -webkit-text-stroke: 1.5px #6f86e6; margin-bottom: 16px; }
  .steps h4 { color: #fff; font-size: 1.5rem; }
  .q-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  .qt { margin: 0; background: #fff; border-radius: var(--r); padding: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; justify-content: space-between; gap: 24px; border: 1px solid var(--line); }
  .qt.big { grid-row: span 2; background: var(--blue); color: #fff; border: 0; }
  .qt blockquote { margin: 0; font: 500 1.12rem/1.5 var(--f-display); }
  .qt.big blockquote { font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem); line-height: 1.38; }
  figcaption { display: flex; align-items: center; gap: 12px; }
  figcaption .mono { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); }
  .qt.big figcaption .mono { background: rgba(255,255,255,.15); color: #fff; }
  .ll h2 { color: #fff; font-size: var(--fs-display-3); }
  .ll-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .ll-stats { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,.2); border-radius: var(--r); overflow: hidden; }
  .ll-stats li { background: var(--blue); padding: 26px 24px; display: grid; gap: 8px; align-content: start; }
  .ll-stats strong { font: 760 clamp(1.8rem, 3vw, 2.6rem)/1 var(--f-display); color: #fff; }
  .ll-stats span { color: #dfe5fb; font-size: .92rem; }
  @media (max-width: 880px) {
    .liv, .spread, .spread.rev { grid-template-columns: minmax(0, 1fr); }
    .spread.rev .sp-img { order: 0; }
    .steps ol { grid-template-columns: minmax(0, 1fr); }
    .q-grid { grid-template-columns: minmax(0, 1fr); }
    .qt.big { grid-row: auto; }
  }
  @media (max-width: 520px) { .ll-stats { grid-template-columns: minmax(0, 1fr); } .pr-head { flex-direction: column; align-items: start; } }
</style>
