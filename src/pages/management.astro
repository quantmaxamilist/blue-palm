---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import Faq from '../components/Faq.astro';
import { management as m, SITE } from '../data/site';
const crumbs = [{ name: 'Management', path: '/management' }];
const cmp = [
    { k: 'Income', m: 'Variable owner income', g: 'Agreed fixed rent' },
    { k: 'Fee', m: '15% management fee', g: 'No management commission' },
    { k: 'Risk', m: 'Owner carries occupancy risk', g: 'Blue Palm carries occupancy risk' },
    { k: 'Best for', m: 'Owners seeking stronger potential returns', g: 'Owners prioritising certainty' },
]; // [client] comparison table supplied by Blue Palm
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: m.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const svc = { '@context': 'https://schema.org', '@type': 'Service', name: m.h1, serviceType: 'Serviced accommodation management', provider: { '@id': SITE + '/#business' }, areaServed: { '@type': 'City', name: 'Cardiff' }, offers: { '@type': 'Offer', description: '15% management fee' } };
---
<Base title={m.title} desc={m.desc} crumbs={crumbs} schema={[faqLd, svc]}>
  <PageHero kicker={m.kicker} h1={m.h1} lede={m.intro[0]} crumbs={crumbs} photo="cathedral-rd-1" photoAlt="Living room with blue sofa in a Blue Palm managed apartment on Cathedral Road">
    <a class="btn white" href="/agents-landlords?service=management#valuation">Free property Assessment <span class="arr">→</span></a>
    <a class="btn ghost light" href="#howitworks">See how management works</a>
  </PageHero>
  <section class="sec">
    <div class="wrap split">
      <div><p class="big" data-reveal><span>15%</span> management fee</p><p class="mono small" data-reveal=".05">{m.small}</p></div>
      <div>{m.intro.slice(1).map((p, i) => <p class="lede" data-reveal={String(i * 0.05)}>{p}</p>)}<p data-reveal>{m.kickerSub}</p></div>
    </div>
  </section>
  <section class="sec cmp" aria-labelledby="cmp-h">
    <div class="wrap">
      <div class="cmp-head">
        <p class="kicker" data-reveal>Two landlord solutions</p>
        <h2 id="cmp-h" data-reveal=".05">Management or guaranteed rent?</h2>
        <p class="lede" data-reveal=".1">We assess the property and recommend the model that best fits its potential and your appetite for risk.</p>
      </div>
      <div class="tbl" data-reveal=".1" role="table" aria-label="Serviced accommodation management compared with guaranteed rent">
        <div class="tr th" role="row"><span role="columnheader"></span><span role="columnheader">Serviced accommodation management</span><span role="columnheader" class="g">Guaranteed rent <em>Most hands-off</em></span></div>
        {cmp.map((r) => <div class="tr" role="row"><span role="rowheader">{r.k}</span><span role="cell" data-l="Management">{r.m}</span><span role="cell" class="g" data-l="Guaranteed rent">{r.g}</span></div>)}
        <div class="tr tf" role="row"><span></span><span role="cell"><a class="link" href="/agents-landlords?service=management#valuation">Ask about management →</a></span><span role="cell" class="g"><a class="btn" href="/agents-landlords?service=rent#valuation">Get a guaranteed rent offer <span class="arr">→</span></a></span></div>
      </div>
    </div>
  </section>
  <section class="sec white">
    <div class="wrap">
      <p class="kicker" data-reveal>{m.moreK}</p><h2 data-reveal=".05">{m.moreH}</h2>
      <div class="split more">
        <div>{m.more.map((p) => <p class="lede" data-reveal>{p}</p>)}</div>
        <ul class="ml">{m.moreList.map((x, i) => <li data-reveal={String(i * 0.04)}><h3>{x.t}</h3><p>{x.d}</p></li>)}</ul>
      </div>
    </div>
  </section>
  <section class="sec dark comm">
    <div class="wrap split">
      <div><p class="kicker" data-reveal>{m.commK}</p><h2 data-reveal=".05">{m.commH}</h2><p class="lede" data-reveal=".1">{m.comm}</p></div>
      <div class="card stat" data-reveal=".1">
        <p class="mono">{m.longH}</p>
        <strong>{m.longStat}</strong>
        <p>{m.longStatD}</p>
        <ul class="ticks">{m.longList.map((x) => <li><span>{x}</span></li>)}</ul>
        <a class="btn white" href="/agents-landlords?service=management#valuation">Work With Us <span class="arr">→</span></a>
      </div>
    </div>
  </section>
  <section class="sec" id="howitworks">
    <div class="wrap">
      <p class="kicker" data-reveal>The service</p><h2 data-reveal=".05">{m.inclH}</h2>
      <div class="incl">{m.incl.map((x, i) => <div class="card" data-reveal={String((i % 3) * 0.05)}><span class="n mono">{String(i + 1).padStart(2, '0')}</span><h3>{x.t}</h3><p>{x.d}</p></div>)}</div>
      <div class="proc">
        <div><h2 data-reveal>{m.processH}</h2><p class="lede" data-reveal=".05">{m.process}</p></div>
        <ol>{m.processSteps.map((s, i) => <li data-reveal={String(i * 0.06)}><span class="n">{i + 1}</span>{s}</li>)}</ol>
        <p class="note" data-reveal>{m.processNote}</p>
      </div>
    </div>
  </section>
  <section class="sec blue">
    <div class="wrap">
      <p class="kicker light" data-reveal>Owners on Blue Palm</p>
      <div class="qs">{m.quotes.map((q, i) => <figure data-reveal={String(i * 0.06)}><blockquote>“{q.q}”</blockquote><figcaption>— {q.n}</figcaption></figure>)}</div>
    </div>
  </section>
  <Faq items={m.faq} title="FAQs" tone="white" />
  <section class="sec">
    <div class="wrap split">
      <div><p class="kicker" data-reveal>{m.assessK}</p><h2 data-reveal=".05">{m.assessH}</h2></div>
      <div>{m.assess.map((p) => <p data-reveal>{p}</p>)}<a class="btn" href="/agents-landlords?service=management#valuation" data-reveal>Free property Assessment <span class="arr">→</span></a></div>
    </div>
  </section>
</Base>
<style>
  .cmp-head { max-width: 760px; margin: 0 auto clamp(28px, 4vw, 44px); text-align: center; }
  .cmp-head .kicker { justify-content: center; }
  .tbl { background: #fff; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; max-width: 1040px; margin-inline: auto; }
  .tr { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1fr) minmax(0, 1fr); border-top: 1px solid var(--line); }
  .tr:first-child { border-top: 0; }
  .tr > span { padding: 20px 22px; }
  .tr > span:first-child { font-weight: 700; }
  .th > span { font: 500 .72rem/1.3 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .g { background: rgba(33,61,153,.05); }
  .th .g { color: var(--blue); }
  .th em { display: inline-block; font-style: normal; margin-left: 8px; padding: 4px 8px; border-radius: 999px; background: var(--blue); color: #fff; letter-spacing: .06em; font-size: .62rem; vertical-align: middle; }
  .tf > span { padding-block: 16px; display: flex; align-items: center; }
  @media (max-width: 720px) {
    .tr { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tr > span:first-child { grid-column: 1 / -1; padding-bottom: 4px; }
    .th > span:first-child, .tf > span:first-child { display: none; }
    .tr > span { padding: 12px 14px; font-size: .93rem; }
    .th em { display: block; margin: 6px 0 0; width: max-content; }
    .tf { grid-template-columns: minmax(0, 1fr); } .tf .btn { width: 100%; } .tf .g { order: -1; }
  }
  .big { font: 760 var(--fs-display-2)/1 var(--f-display); margin: 0; }
  .big span { color: var(--blue); font-size: 1.8em; display: block; }
  .small { font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: var(--blue); margin-top: 18px; }
  .more { margin-top: 30px; }
  .ml { list-style: none; padding: 0; margin: 0; }
  .ml li { border-top: 1px solid var(--line); padding: 20px 0; }
  .ml h3 { font-size: 1.3rem; margin-bottom: 6px; } .ml p { color: var(--muted); margin: 0; }
  .comm h2 { color: #fff; }
  .stat { display: grid; gap: 14px; }
  .stat .mono { font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: #aebcf2; margin: 0; }
  .stat strong { font: 800 var(--fs-display-1)/1 var(--f-display); color: #fff; }
  .incl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 36px 0 70px; }
  .incl .n { color: var(--blue); font-size: .8rem; }
  .incl h3 { font-size: 1.35rem; margin: 10px 0 8px; } .incl p { color: var(--muted); margin: 0; }
  .proc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 30px 60px; align-items: start; }
  .proc ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .proc li { display: flex; align-items: center; gap: 16px; padding: 18px 22px; border-radius: var(--r-s); background: #fff; border: 1px solid var(--line); font: 650 1.2rem/1.2 var(--f-display); }
  .proc li .n { width: 40px; height: 40px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-size: 1rem; flex: none; }
  .note { grid-column: 1 / -1; color: var(--muted); max-width: 70ch; }
  .qs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; margin-top: 10px; }
  .qs figure { margin: 0; }
  .qs blockquote { margin: 0 0 14px; font: 500 1.25rem/1.45 var(--f-display); color: #fff; }
  .qs figcaption { color: #dfe5fb; font-weight: 600; }
  @media (max-width: 900px) { .incl, .qs, .proc { grid-template-columns: minmax(0, 1fr); } }
</style>
