---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { landlordAreas, landlords as l } from '../../data/site';
const crumbs = [{ name: 'Guaranteed rent', path: '/guaranteed-rent' }];
---
<Base title="Guaranteed Rent South Wales | Cardiff, Newport, Penarth & more – Blue Palm" desc="Guaranteed rent for landlords across South Wales — Cardiff, Penarth, Barry, Newport, Caerphilly, Pontypridd, Bridgend, Cowbridge, Swansea and the Vale of Glamorgan. No voids, no management fees." crumbs={crumbs}>
  <PageHero kicker={l.serving} h1="Guaranteed rent across South Wales" lede={l.sub} crumbs={crumbs}>
    <a class="btn white" href="/contact-1">Free Property Assessment <span class="arr">→</span></a>
  </PageHero>
  <section class="sec">
    <div class="wrap">
      <ul class="areas">{landlordAreas.map((a) => <li data-reveal><a href={`/guaranteed-rent/${a.slug}`}><strong>{a.name.replace(/^the /, 'The ')}</strong><span class="mono">Guaranteed rent</span><i aria-hidden="true">→</i></a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .areas { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .areas a { background: #fff; padding: 26px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; text-decoration: none; transition: background .25s, color .25s; height: 100%; }
  .areas a:hover { background: var(--blue); color: #fff; }
  .areas strong { font: 700 1.5rem/1.1 var(--f-display); }
  .areas .mono { font-size: .74rem; color: var(--muted); }
  .areas a:hover .mono { color: #dfe5fb; }
  .areas i { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-style: normal; font-size: 1.3rem; }
  @media (max-width: 900px) { .areas { grid-template-columns: minmax(0, 1fr); } }
</style>
