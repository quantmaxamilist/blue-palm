---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { guestAreas, nearestBase, fmtMiles, home } from '../../data/site';
const crumbs = [{ name: 'Serviced apartments', path: '/serviced-apartments' }];
---
<Base title="Serviced Apartments in Cardiff by Area | Corporate Housing – Blue Palm" desc="Find Blue Palm serviced apartments near your Cardiff assignment — City Centre, Canton, Llandaff, Riverside, Cathays, Roath, Butetown, Penarth and more. Corporate housing in Pontcanna & Cardiff Bay." crumbs={crumbs}>
  <PageHero kicker="Corporate housing in Cardiff" h1="Serviced apartments, wherever the work is." lede={home.lede} crumbs={crumbs} />
  <section class="sec">
    <div class="wrap">
      <ul class="areas">{guestAreas.map((a) => { const n = nearestBase(a); return <li data-reveal><a href={`/serviced-apartments/${a.slug}`}><strong>{a.name}</strong><span class="mono">{fmtMiles(n.d)} to {n.name}</span><i aria-hidden="true">→</i></a></li>; })}</ul>
    </div>
  </section>
</Base>
<style>
  .areas { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .areas a { background: #fff; padding: 26px 26px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; text-decoration: none; transition: background .25s, color .25s; height: 100%; }
  .areas a:hover { background: var(--blue); color: #fff; }
  .areas strong { font: 700 1.5rem/1.1 var(--f-display); }
  .areas .mono { grid-column: 1; font-size: .74rem; color: var(--muted); }
  .areas a:hover .mono { color: #dfe5fb; }
  .areas i { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-style: normal; font-size: 1.3rem; }
  @media (max-width: 900px) { .areas { grid-template-columns: minmax(0, 1fr); } }
</style>
