---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
import Clients from '../../components/Clients.astro';
import Faq from '../../components/Faq.astro';
import { guestAreas, properties, corporate, home, nearestBase, fmtMiles, bases, miles, SITE } from '../../data/site';
export function getStaticPaths() { return guestAreas.map((a) => ({ params: { area: a.slug }, props: { a } })); }
const { a } = Astro.props;
const near = nearestBase(a);
const dists = bases.map((b) => ({ ...b, d: miles(a, b) }));
const props = properties.filter((p) => p.area === near.name).slice(0, 3);
const crumbs = [{ name: 'Serviced apartments', path: '/serviced-apartments' }, { name: a.name, path: `/serviced-apartments/${a.slug}` }];
const title = `Serviced Apartments near ${a.name}, Cardiff | Corporate Housing – Blue Palm`;
const desc = `Fully serviced corporate apartments near ${a.name}, Cardiff — Blue Palm homes in ${near.name}, ${fmtMiles(near.d)} away. Flexible long-term stays for professionals, relocations, contractors and production teams.`;
const faq = [
  { q: `Do you have serviced apartments near ${a.name}?`, a: `Yes. Blue Palm's fully serviced corporate apartments are in ${near.name}, ${fmtMiles(near.d)} from ${a.name}${dists.length > 1 ? `, with further apartments in ${dists.find((d) => d.name !== near.name)!.name}` : ''}.` },
  ...corporate.faq.slice(0, 4),
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `Serviced apartments near ${a.name}, Cardiff`, serviceType: 'Corporate housing / serviced apartments', provider: { '@id': SITE + '/#business' }, areaServed: { '@type': 'Place', name: `${a.name}, Cardiff`, geo: { '@type': 'GeoCoordinates', latitude: a.lat, longitude: a.lng } } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const others = guestAreas.filter((x) => x.slug !== a.slug).sort((x, y) => miles(a, x) - miles(a, y)).slice(0, 8);
---
<Base title={title} desc={desc} crumbs={crumbs} schema={ld}>
  <PageHero kicker={`Corporate housing · ${a.name}`} h1={`Serviced Apartments near ${a.name}, Cardiff`} lede={home.lede} crumbs={crumbs} photo={props[0]?.imgs[0] ?? 'hamilton-ground-floor-1'} photoAlt={`Blue Palm serviced apartment near ${a.name}, Cardiff`}>
    <a class="btn white" href="/contact">Book your stay <span class="arr">→</span></a>
    <a class="btn ghost light" href="/properties">View apartments</a>
  </PageHero>
  <section class="sec">
    <div class="wrap split">
      <div>
        <p class="kicker" data-reveal>{a.name}</p>
        <h2 data-reveal=".05">Your base near {a.name}.</h2>
        <ul class="dist" data-reveal=".1">{dists.sort((x, y) => x.d - y.d).map((d) => <li><strong>{fmtMiles(d.d)}</strong><span>to our {d.name} apartments</span></li>)}</ul>
      </div>
      <div>
        {corporate.intro.map((p) => <p data-reveal>{p}</p>)}
        <p class="statement" data-reveal>{home.ideal}</p>
      </div>
    </div>
  </section>
  <Clients />
  <section class="sec white">
    <div class="wrap">
      <h2>{corporate.whyH}</h2>
      <div class="why">{corporate.why.map((w) => <div class="card" data-reveal><h3>{w.t}</h3><p>{w.d}</p></div>)}</div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="h2row"><h2>Apartments in {near.name}</h2><a class="link" href="/properties">All properties →</a></div>
      <div class="grid3">{props.map((p, i) => <PropertyCard p={p} i={i} />)}</div>
    </div>
  </section>
  <Faq items={faq} tone="white" />
  <GoogleReviews tone="light" />
  <section class="sec">
    <div class="wrap"><h2 class="sm">Serviced apartments near other parts of Cardiff</h2><ul class="chips">{others.map((o) => <li><a href={`/serviced-apartments/${o.slug}`}>{o.name}</a></li>)}<li><a href="/serviced-apartments">All areas →</a></li></ul></div>
  </section>
</Base>
<style>
  .dist { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 12px; }
  .dist li { display: grid; gap: 2px; border-top: 1px solid var(--line); padding-top: 12px; }
  .dist strong { font: 760 1.8rem/1 var(--f-display); color: var(--blue); }
  .dist span { color: var(--muted); }
  .statement { color: var(--blue); }
  .why { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .why h3 { font-size: 1.35rem; } .why p { color: var(--muted); margin: 0; font-size: .95rem; }
  .h2row { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 30px; }
  .h2row h2 { margin: 0; }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .sm { font-size: var(--fs-display-3); }
  .chips { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-block; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line); background: #fff; text-decoration: none; font-weight: 600; }
  .chips a:hover { background: var(--blue); color: #fff; }
  @media (max-width: 1000px) { .why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .why, .grid3 { grid-template-columns: minmax(0, 1fr); } }
</style>
