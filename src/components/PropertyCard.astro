---
import Pic from './Pic.astro';
import type { Property } from '../data/site';
interface Props { p: Property; i?: number }
const { p, i = 0 } = Astro.props;
---
<div class="pcw" data-area={p.area} data-reveal={String((i % 3) * 0.06)}>
<a class="pc" href={`/${p.slug}`}>
  <div class="ph"><Pic k={p.imgs[0]} alt={`${p.name} serviced apartment`} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" w={800} /><span class="area mono">{p.area}</span></div>
  <h3>{p.name}</h3>
  <p class="spec mono">{p.spec}</p>
  <p class="d">{p.card}</p>
  <span class="link">View apartment <span aria-hidden="true">→</span></span>
</a>
</div>
<style>
  .pcw { display: flex; flex-direction: column; }
  .pc { flex: 1; display: flex; flex-direction: column; text-decoration: none; }
  .ph { aspect-ratio: 4 / 3; margin-bottom: 18px; }
  .ph :global(img) { transition: transform 1s var(--ease); }
  .pc:hover .ph :global(img) { transform: scale(1.05); }
  .area { position: absolute; left: 14px; top: 14px; background: rgba(255,255,255,.92); color: var(--blue); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; padding: 7px 11px; border-radius: 999px; }
  h3 { font-size: 1.55rem; margin-bottom: 6px; }
  .spec { font-size: .78rem; color: var(--blue); margin-bottom: 10px; }
  .d { color: var(--muted); font-size: .96rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .link { margin-top: auto; }
</style>
