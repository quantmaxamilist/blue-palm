---
import { brand, contact, social, google, nav, properties, guestAreas, landlordAreas } from '../data/site';
interface Props { band?: boolean }
const { band = true } = Astro.props;
const uniq = [...new Map(properties.map((p) => [p.slug, p])).values()];
---
{band && (
  <section class="band blue" aria-labelledby="band-h">
    <div class="wrap band-in">
      <div class="disc" aria-hidden="true"></div>
      <div>
        <p class="kicker light">Need accommodation in Cardiff for your team or project?</p>
        <h2 id="band-h">Book Corporate Accommodation in Cardiff</h2>
        <p class="lede">Get in touch with Blue Palm to discuss availability, long-stay rates and flexible booking options.</p>
      </div>
      <div class="band-cta">
        <a class="btn white" href="/contact">Book your stay <span class="arr">→</span></a>
        <a class="btn ghost" href="/contact-1">Landlords: free property assessment</a>
        <p class="mono small">{contact.reply}</p>
      </div>
    </div>
  </section>
)}
<footer class="ftr">
  <div class="wrap ftr-grid">
    <div class="ftr-brand">
      <a href="/" class="fl" aria-label="Blue Palm — home"><img src="/img/brand/blue-palm-logo.png" width="72" height="72" alt="" loading="lazy" /><span>Blue Palm</span></a>
      <p>Fully serviced corporate apartments in Pontcanna &amp; Cardiff Bay. Guaranteed rent and serviced accommodation management for landlords across South Wales.</p>
      <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
      <div class="soc">
        <a href={google.url} target="_blank" rel="noopener">Google ★ {google.rating.toFixed(1)}</a>
        <a href={social.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
    <div>
      <h3>Explore</h3>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/cardiff-bay">Cardiff Bay</a></li><li><a href="/contact">Book your stay</a></li></ul>
    </div>
    <div>
      <h3>Apartments</h3>
      <ul>{uniq.map((p) => <li><a href={`/${p.slug}`}>{p.street} · {p.beds} bed</a></li>)}</ul>
    </div>
    <div>
      <h3>Serviced apartments near</h3>
      <ul>{guestAreas.slice(0, 8).map((a) => <li><a href={`/serviced-apartments/${a.slug}`}>{a.name}</a></li>)}<li><a href="/serviced-apartments">All areas →</a></li></ul>
    </div>
    <div>
      <h3>Guaranteed rent</h3>
      <ul>{landlordAreas.slice(0, 8).map((a) => <li><a href={`/guaranteed-rent/${a.slug}`}>{a.name.replace(/^the /, 'The ')}</a></li>)}<li><a href="/guaranteed-rent">All areas →</a></li></ul>
    </div>
  </div>
  <div class="wrap ftr-base mono">
    <span>© {brand.legal} {new Date().getFullYear()} | {brand.reg}</span>
    <span>Site by <a href="https://quantweb.co.uk" rel="noopener">Quantweb</a></span>
  </div>
</footer>

<style>
  .band { padding-block: clamp(72px, 10vw, 128px); overflow: hidden; position: relative; }
  .band-in { display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: 40px; align-items: end; position: relative; z-index: 1; }
  .band h2 { color: #fff; max-width: 16ch; }
  .band .lede { color: #dfe5fb; margin: 0; }
  .disc { position: absolute; right: -14vw; top: 50%; width: min(64vw, 820px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.1), rgba(255,255,255,.03) 70%, transparent 71%); translate: 0 -50%; z-index: -1; pointer-events: none; }
  .disc::after { content: ''; position: absolute; inset: 16%; border-radius: 50%; border: 1px solid rgba(255,255,255,.14); }
  .band-cta { display: grid; gap: 10px; justify-items: start; }
  .small { font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: #c3cdf5 !important; margin: 6px 0 0; }
  .ftr { background: var(--night); color: #c3c9da; padding: 84px 0 28px; font-size: .95rem; }
  .ftr-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr)); gap: 36px; }
  .ftr h3 { font: 500 .72rem/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: #8790aa; margin-bottom: 18px; }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .ftr a { color: #eef1fb; text-decoration: none; }
  .ftr a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .fl { display: inline-flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .fl span { font: 760 1.8rem/1 var(--f-display); letter-spacing: -.02em; }
  .fl img { width: 64px; height: 64px; }
  .ftr-brand p { max-width: 38ch; }
  .mail { display: inline-block; font-weight: 600; margin-bottom: 18px; }
  .soc { display: flex; gap: 18px; flex-wrap: wrap; }
  .ftr-base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line-d); font-size: .74rem; color: #8790aa; }
  @media (max-width: 1080px) { .ftr-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .ftr-brand { grid-column: 1 / -1; } .band-in { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .ftr-grid { grid-template-columns: minmax(0, 1fr); } .band-cta, .band-cta .btn { width: 100%; } }
</style>
