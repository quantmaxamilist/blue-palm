---
import type { Property } from '../data/site';
interface Props { p: Property; compact?: boolean }
const { p, compact = false } = Astro.props;
const q = `${p.street}, ${p.area === 'Cardiff Bay' ? 'Cardiff Bay, ' : 'Pontcanna, '}Cardiff`;
const src = `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=${compact ? 15 : 16}&output=embed`;
const open = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---
<div class:list={['pmap', { compact }]}>
  <iframe src={src} title={`Map showing ${p.street}, ${p.area}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  <a class="open mono" href={open} target="_blank" rel="noopener">Open in Google Maps ↗</a>
</div>
<style>
  .pmap { position: relative; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line); background: #e9edf6; aspect-ratio: 16 / 7; }
  .pmap.compact { aspect-ratio: 16 / 9; margin-top: 14px; }
  iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .open { position: absolute; right: 10px; bottom: 10px; background: #fff; color: var(--blue); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; padding: 7px 10px; border-radius: 999px; text-decoration: none; box-shadow: 0 6px 16px -8px rgba(0,0,0,.4); }
  @media (max-width: 700px) { .pmap { aspect-ratio: 4 / 3; } }
</style>
