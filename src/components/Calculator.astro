---
// Landlord Rental Income Calculator — same engine, ranges and defaults as the old bluepalmproperty.co.uk calculator.
import { landlords } from '../data/site';
const sliders = [
  { id: 'rent', label: 'Monthly Rent', help: 'The gross monthly rent your property currently achieves or is marketed at.', min: 500, max: 5000, step: 50, value: 1200, fmt: '£' },
  { id: 'voidWeeks', label: 'Avg Void Period', help: 'How many weeks your property sits empty between tenancies. The UK average is 3–5 weeks per changeover.', min: 0, max: 26, step: 1, value: 3, fmt: 'weeks' },
  { id: 'tenancyMonths', label: 'Avg Tenancy Length', help: 'How long each tenant typically stays. UK average is 12–18 months.', min: 6, max: 48, step: 1, value: 12, fmt: 'months' },
  { id: 'maintenance', label: 'Annual Maintenance', help: 'Annual spend on repairs, appliances, and upkeep. Industry guideline is 1–2% of property value per year.', min: 0, max: 10000, step: 100, value: 1500, fmt: '£' },
  { id: 'renewalFee', label: 'Tenant Renewal Fees', help: 'Costs per tenancy changeover: referencing, credit checks, inventories, and admin. Typically £150–£500.', min: 0, max: 1000, step: 25, value: 300, fmt: '£' },
  { id: 'mgmtFee', label: 'Management Fee %', help: 'Monthly management fee charged by your letting agent as a % of rent. UK average is 10–20%.', min: 0, max: 30, step: 1, value: 19, fmt: '%' },
];
const adv = [
  { id: 'bpRate', label: 'Blue Palm Guaranteed Monthly Income', help: 'Blue Palm pays you a guaranteed monthly rent — regardless of voids, tenant issues, or market conditions.', min: 70, max: 100, step: 1, value: 100, fmt: '%' },
  { id: 'bpMaintPct', label: 'Blue Palm Maintenance Contribution', help: 'Blue Palm absorbs a portion of maintenance as part of the partnership. Default is 10%.', min: 0, max: 50, step: 5, value: 10, fmt: '%' },
  { id: 'rentUplift', label: 'Annual Rent Uplift (%)', help: 'Expected annual rental growth. UK 5-year average is roughly 3% per year.', min: 0, max: 8, step: 0.5, value: 3, fmt: '%' },
];
---
<section class="calc sec dark" id="open-calculator" aria-labelledby="calc-h" data-calc>
  <div class="wrap">
    <div class="c-head">
      <p class="kicker">Free tool</p>
      <h2 id="calc-h">{landlords.calcH}</h2>
      <p class="lede">{landlords.calcSub}. Sliders are pre-set to UK market averages.</p>
    </div>
    <div class="c-grid">
      <div class="inputs">
        {[...sliders, ...adv].map((s, i) => (
          <div class:list={['sl', { adv: i >= sliders.length }]}>
            <div class="sl-top"><label for={`c-${s.id}`}>{s.label}</label><output class="mono" data-out={s.id}></output></div>
            <input type="range" id={`c-${s.id}`} data-in={s.id} data-fmt={s.fmt} min={s.min} max={s.max} step={s.step} value={s.value} aria-describedby={`h-${s.id}`} />
            <p class="help" id={`h-${s.id}`}>{s.help}</p>
          </div>
        ))}
        <div class="years" role="group" aria-label="Projection period">
          <span>Projection Period</span>
          <button class="on" data-years="3" aria-pressed="true">3 Years</button>
          <button data-years="5" aria-pressed="false">5 Years</button>
        </div>
      </div>
      <div class="results" aria-live="polite">
        <p class="mono r-k">Additional profit with Blue Palm over <span data-yrs>3 years</span></p>
        <p class="r-big" data-r="diff">£0</p>
        <p class="r-sub">compared to traditional buy-to-let</p>
        <div class="r-row">
          <div><span class="mono">Monthly difference</span><strong data-r="monthly">£0</strong></div>
          <div><span class="mono">Annual difference</span><strong data-r="annual">£0</strong></div>
          <div><span class="mono">Hidden costs</span><strong data-r="hidden">£0</strong></div>
        </div>
        <div class="bars">
          <p class="mono">Net Profit Comparison — <span data-yrs2>3-Year</span> Projection</p>
          <div class="bar"><span class="bl">Traditional</span><span class="track"><i data-bar="trad"></i></span><b data-r="tradNet">£0</b></div>
          <div class="bar bp"><span class="bl">Blue Palm</span><span class="track"><i data-bar="bp"></i></span><b data-r="bpNet">£0</b></div>
        </div>
        <details class="break">
          <summary>See the breakdown</summary>
          <div class="cols">
            <div><h4>Traditional Letting</h4><dl><dt>Gross rent</dt><dd data-r="tradGross"></dd><dt>Void periods</dt><dd data-r="tradVoids"></dd><dt>Management fees</dt><dd data-r="tradMgmt"></dd><dt>Maintenance</dt><dd data-r="tradMaint"></dd><dt>Tenant turnover</dt><dd data-r="tradTurnover"></dd></dl></div>
            <div><h4>Blue Palm Partnership</h4><dl><dt>Guaranteed income</dt><dd data-r="bpIncome"></dd><dt>Maintenance contribution</dt><dd data-r="bpMaint"></dd></dl></div>
          </div>
        </details>
        <a class="btn white" href="/agents-landlords?service=rent#valuation">Book My Free Assessment <span class="arr">→</span></a>
        <p class="fine">An illustration based on the figures you enter, not an offer. Your guaranteed rent figure is confirmed after a free property assessment.</p>
      </div>
    </div>
  </div>
</section>
<style>
  .calc { background: var(--ink); scroll-margin-top: 90px; }
  .calc.flash .results { box-shadow: 0 0 0 3px #8fa3f0, 0 40px 80px -40px #000; }
  .c-head { max-width: 760px; margin-bottom: 44px; }
  .c-head h2 { color: #fff; }
  .c-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 60px); align-items: start; }
  .inputs { display: grid; gap: 22px; }
  .sl-top { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .sl label { font-weight: 600; color: #fff; }
  .sl output { color: #aebcf2; font-size: .95rem; }
  .help { font-size: .82rem; color: #8f98b4 !important; margin: 6px 0 0; }
  .sl.adv { padding-top: 18px; border-top: 1px solid var(--line-d); }
  .sl.adv ~ .sl.adv { border-top: 0; padding-top: 0; }
  input[type='range'] { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 6px; margin-top: 12px; background: linear-gradient(to right, #6f86e6 var(--p, 50%), rgba(255,255,255,.14) var(--p, 50%)); cursor: pointer; }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 5px solid var(--blue); box-shadow: 0 4px 12px rgba(0,0,0,.4); }
  input[type='range']::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 5px solid var(--blue); }
  .years { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; color: #fff; font-weight: 600; }
  .years span { margin-right: 6px; }
  .years button { font: 600 .9rem/1 var(--f-body); padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line-d); background: transparent; color: #fff; cursor: pointer; }
  .years button.on { background: #fff; color: var(--blue); }
  .results { position: sticky; top: 100px; background: var(--blue); border-radius: calc(var(--r) + 6px); padding: clamp(24px, 3vw, 40px); box-shadow: 0 40px 80px -40px #000; transition: box-shadow .4s; }
  .r-k { font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: #c9d3f7 !important; margin: 0; }
  .r-big { font: 800 clamp(2.6rem, 2rem + 3vw, 4.8rem)/1 var(--f-display); color: #fff !important; margin: 10px 0 4px; letter-spacing: -.03em; }
  .r-big.neg { color: #ffc4c4 !important; }
  .r-sub { color: #dfe5fb !important; margin-bottom: 24px; }
  .r-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 26px; }
  .r-row div { background: rgba(255,255,255,.1); border-radius: 14px; padding: 14px; display: grid; gap: 6px; }
  .r-row .mono { font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; color: #c9d3f7; }
  .r-row strong { font: 700 1.2rem/1 var(--f-display); color: #fff; }
  .bars > .mono { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: #c9d3f7 !important; }
  .bar { display: grid; grid-template-columns: 92px minmax(0, 1fr) auto; gap: 12px; align-items: center; margin-top: 10px; color: #fff; font-size: .9rem; }
  .track { height: 12px; border-radius: 12px; background: rgba(255,255,255,.12); overflow: hidden; }
  .track i { display: block; height: 100%; width: 0; background: rgba(255,255,255,.45); border-radius: 12px; transition: width .6s var(--ease); }
  .bar.bp .track i { background: #fff; }
  .break { margin: 22px 0; color: #fff; }
  .break summary { cursor: pointer; font-weight: 600; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; margin-top: 14px; }
  .cols h4 { color: #fff; font-size: 1rem; }
  dl { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 12px; margin: 0; font-size: .88rem; }
  dt { color: #c9d3f7; } dd { margin: 0; color: #fff; text-align: right; }
  .fine { font-size: .76rem; color: #c9d3f7 !important; margin: 14px 0 0; }
  @media (max-width: 900px) { .c-grid { grid-template-columns: minmax(0, 1fr); } .results { position: static; } }
  @media (max-width: 520px) { .r-row { grid-template-columns: minmax(0, 1fr); } .cols { grid-template-columns: minmax(0, 1fr); } }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const fmt = (n: number) => '£' + Math.round(n).toLocaleString('en-GB');
    const v = (id: string) => parseFloat(root.querySelector<HTMLInputElement>(`[data-in="${id}"]`)!.value) || 0;
    let years = 3;
    const set = (k: string, t: string) => root.querySelectorAll<HTMLElement>(`[data-r="${k}"]`).forEach((e) => (e.textContent = t));
    const label = (inp: HTMLInputElement) => {
      const n = parseFloat(inp.value), f = inp.dataset.fmt;
      const t = f === '£' ? fmt(n) : f === '%' ? n + '%' : f === 'weeks' ? n + (n === 1 ? ' week' : ' weeks') : n + (n === 1 ? ' month' : ' months');
      const o = root.querySelector<HTMLElement>(`[data-out="${inp.dataset.in}"]`);
      if (o) o.textContent = inp.dataset.in === 'bpRate' ? `${t} · ${fmt(v('rent') * n / 100)} / month guaranteed` : t;
      inp.style.setProperty('--p', ((n - +inp.min) / (+inp.max - +inp.min)) * 100 + '%');
    };
    const calc = () => {
      const rent = v('rent'), voidWeeks = v('voidWeeks'), tenancyMo = v('tenancyMonths'), maintenance = v('maintenance'), renewalFee = v('renewalFee');
      const mgmtPct = v('mgmtFee') / 100, bpRatePct = v('bpRate') / 100, bpMaintPct = v('bpMaintPct') / 100, uplift = v('rentUplift') / 100;
      const cycle = tenancyMo + (voidWeeks * 12) / 52, tpy = 12 / cycle;
      let tG = 0, tV = 0, tM = 0, tMa = 0, tT = 0, cur = rent;
      for (let y = 0; y < years; y++) {
        const g = cur * 12, vd = cur * ((voidWeeks * 12) / 52) * tpy;
        tG += g; tV += vd; tM += (g - vd) * mgmtPct; tMa += maintenance; tT += renewalFee * tpy; cur *= 1 + uplift;
      }
      const tradNet = tG - tV - tM - tMa - tT;
      let bI = 0, bM = 0; cur = rent;
      for (let y = 0; y < years; y++) { bI += cur * bpRatePct * 12; bM += maintenance * bpMaintPct; cur *= 1 + uplift; }
      const bpNet = bI - bM, diff = bpNet - tradNet;
      const big = root.querySelector<HTMLElement>('[data-r="diff"]')!;
      big.textContent = (diff < 0 ? '−' : '') + fmt(Math.abs(diff)); big.classList.toggle('neg', diff < 0);
      set('monthly', fmt(Math.abs(diff / (years * 12)))); set('annual', fmt(Math.abs(diff / years))); set('hidden', fmt(tV + tM + tT));
      set('tradNet', fmt(tradNet)); set('bpNet', fmt(bpNet)); set('tradGross', fmt(tG)); set('tradVoids', '-' + fmt(tV)); set('tradMgmt', '-' + fmt(tM)); set('tradMaint', '-' + fmt(tMa)); set('tradTurnover', '-' + fmt(tT));
      set('bpIncome', fmt(bI)); set('bpMaint', bM > 0 ? '-' + fmt(bM) : '£0');
      const max = Math.max(tradNet, bpNet, 1);
      root.querySelector<HTMLElement>('[data-bar="trad"]')!.style.width = Math.max(0, (tradNet / max) * 100) + '%';
      root.querySelector<HTMLElement>('[data-bar="bp"]')!.style.width = Math.max(0, (bpNet / max) * 100) + '%';
      root.querySelectorAll('[data-yrs]').forEach((e) => (e.textContent = years + ' years'));
      root.querySelectorAll('[data-yrs2]').forEach((e) => (e.textContent = years + '-Year'));
    };
    const all = root.querySelectorAll<HTMLInputElement>('[data-in]');
    all.forEach((inp) => { label(inp); inp.addEventListener('input', () => { all.forEach(label); calc(); }); });
    root.querySelectorAll<HTMLButtonElement>('[data-years]').forEach((b) => b.addEventListener('click', () => {
      years = +b.dataset.years!; root.querySelectorAll<HTMLButtonElement>('[data-years]').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); }); calc();
    }));
    calc();
    // printed flyer QR codes link to #open-calculator — land on it and highlight
    const open = () => { if (location.hash === '#open-calculator') { setTimeout(() => { (window as any).__lenis?.scrollTo(root, { offset: -80, immediate: true }) ?? root.scrollIntoView(); root.classList.add('flash'); setTimeout(() => root.classList.remove('flash'), 1800); root.querySelector<HTMLInputElement>('[data-in="rent"]')?.focus({ preventScroll: true }); }, 250); } };
    open(); addEventListener('hashchange', open);
  }
</script>
